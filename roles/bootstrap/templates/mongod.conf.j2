# MANAGED BY MES AIDES OPS
# Modifications should be made in templates/mongod.conf.j2

storage:
  dbPath: /var/lib/mongodb

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

# Boucle locale seulement : tous les clients tournent sur la machine.
net:
  port: 27017
  bindIp: 127.0.0.1

processManagement:
  timeZoneInfo: /usr/share/zoneinfo
